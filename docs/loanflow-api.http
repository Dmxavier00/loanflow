@baseUrl = http://localhost:8080
@tokenSolicitante = cole_o_token_do_solicitante_aqui
@tokenCredor = cole_o_token_do_credor_aqui
@tokenAdmin = cole_o_token_do_admin_aqui
@usuarioId = 1
@credorId = 1
@propostaId = 1
@contratoId = 1
@parcelaId = 1
@pagamentoId = 1

### Observação
# Para autenticar sem cadastrar novos usuários via API, prefira os demos
# documentados em docs/usuarios-demo.md.

### 1. Registrar solicitante
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nome": "Davi Solicitante",
  "cpf": "529.982.247-25",
  "email": "solicitante@loanflow.com",
  "estadoCivil": "SOLTEIRO",
  "nacionalidade": "Brasileira",
  "profissao": "Analista",
  "dataNascimento": "1994-03-12",
  "telefone": "11999990000",
  "tipoDocumentoIdentidade": "RG",
  "documentoIdentidade": "12345678",
  "orgaoEmissor": "SSP-SP",
  "pessoaExpostaPoliticamente": false,
  "endereco": {
    "cep": "01001-000",
    "logradouro": "Praça da Sé",
    "numero": "100",
